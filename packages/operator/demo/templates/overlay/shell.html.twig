{#
  Demo chrome for the Anokii operator shell.

  Anokii\Operator\Demo\OperatorDemo puts this directory ahead of the package
  templates in the demo process only, so it shadows
  @anokii_operator/shell.html.twig there and extends the real shell. The
  unmodified dashboard and module templates therefore render with:
    - a persistent "Demo: nothing is saved or sent" marker at the top of the
      main column, with its measured height reserved as scroll padding so
      content scrolled to the top stops below it;
    - an inert user chip that labels the fixture identity as a sample and
      has no sign-out link.
  Production routing never loads this file.
#}
{% extends '@anokii_operator_base/shell.html.twig' %}

{% block title %}{{ page_title }} | {{ brand_title }}{% endblock %}

{% block userchip %}
<div class="anokii-userchip">
  <div class="anokii-avatar" aria-hidden="true">{{ user_initials }}</div>
  <div class="anokii-uinfo"><b>{{ user_label }}</b><small>{{ user_role }}</small><small class="anokii-demo-sample">Sample identity. Sign-out is off.</small></div>
</div>
{% endblock %}

{% block topbar %}
<style>
  /* The marker is sticky, so a scroll that brings something to the top of
     the page, such as a fragment link or scrollIntoView({block: 'start'}),
     stops below it, with an 8px gap. The script below keeps
     --anokii-demo-flag-height equal to the marker's rendered height, which
     grows when its text wraps or is resized. Until the script runs, or if
     scripts are off, 40px stands in: the one-line marker at default text
     size is 9px + 14px x 1.4 + 9px + a 2px border. */
  html{scroll-padding-top:calc(var(--anokii-demo-flag-height, 40px) + 8px)}
  .anokii-demo-flag{position:sticky;top:0;z-index:20;margin:0;padding:9px 30px;background:#fff4ce;color:#3d2e00;border-bottom:2px solid #8a6100;font-size:14px;font-weight:650;line-height:1.4}
  .anokii-demo-sample{display:block}
  @media(max-width:880px){.anokii-demo-flag{padding:9px 16px}}
</style>
<p class="anokii-demo-flag" data-anokii-demo-flag>Demo: nothing is saved or sent</p>
<script>
  (() => {
    // Measure the marker as soon as it exists, before any fragment scroll,
    // and again whenever its size changes.
    const flag = document.querySelector('[data-anokii-demo-flag]');
    if (!(flag instanceof HTMLElement)) return;
    const reserve = () => {
      document.documentElement.style.setProperty('--anokii-demo-flag-height', `${Math.ceil(flag.getBoundingClientRect().height)}px`);
    };
    reserve();
    if (typeof ResizeObserver === 'function') new ResizeObserver(reserve).observe(flag, { box: 'border-box' });
  })();
</script>
{% endblock %}
