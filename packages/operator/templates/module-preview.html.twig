{% extends '@anokii_operator/shell.html.twig' %}

{% block title %}{{ page_title }} | {{ brand_title }}{% endblock %}

{% block shell_styles %}
  .module-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}.module-head h1{font-family:var(--anokii-shell-display-font,inherit);font-size:38px;line-height:1.08}.module-head p{max-width:58ch;margin-top:8px;color:var(--anokii-shell-muted)}
  .preview-flag{padding:6px 10px;border:1px solid var(--anokii-shell-line);border-radius:999px;color:var(--anokii-shell-muted);background:#fff;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}
  .work-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:18px}.panel{padding:22px;border:1px solid var(--anokii-shell-line);border-radius:14px;background:var(--anokii-shell-card)}.panel h2{font-size:19px;margin-bottom:6px}.panel>p{color:var(--anokii-shell-muted);font-size:14px}.task-list{margin-top:18px;border-top:1px solid var(--anokii-shell-line)}.task{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:58px;padding:11px 0;border-bottom:1px solid var(--anokii-shell-line)}.task b{display:block}.task small{color:var(--anokii-shell-muted)}.task span{padding:5px 8px;border-radius:999px;background:var(--anokii-shell-accent-soft,#eef5f4);color:var(--anokii-shell-accent);font-size:11px;font-weight:700}.quick{display:grid;gap:10px;margin-top:18px}.quick a{display:flex;align-items:center;min-height:46px;padding:10px 13px;border:1px solid var(--anokii-shell-line);border-radius:9px;font-weight:650}.quick a:hover{border-color:var(--anokii-shell-accent)}
  @media(max-width:900px){.work-grid{grid-template-columns:1fr}.module-head{align-items:flex-start;flex-direction:column}}
{% endblock %}

{% block content %}
<header class="module-head"><div><p class="eyebrow">{{ page_eyebrow }}</p><h1>{{ page_title }}</h1><p>{{ page_intro }}</p></div><span class="preview-flag">Local shell preview</span></header>
<div class="work-grid">
  <section class="panel"><h2>{{ primary_title }}</h2><p>{{ primary_intro }}</p><div class="task-list">{% for row in preview_rows %}<div class="task"><div><b>{{ row.title }}</b><small>{{ row.detail }}</small></div><span>{{ row.state }}</span></div>{% endfor %}</div></section>
  <aside class="panel"><h2>Common tasks</h2><p>These become real actions as the operator modules are connected.</p><div class="quick">{% for action in quick_actions %}<a href="{{ action.href }}">{{ action.label }}</a>{% endfor %}</div></aside>
</div>
{% endblock %}
