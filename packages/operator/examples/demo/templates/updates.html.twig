{#
  Fictional host workflow page. It extends the operator shell exactly as a
  live module page would and overrides only page blocks; the demo supplies the
  brand, nav, user chip, and demo marker.
#}
{% extends '@anokii_operator/shell.html.twig' %}

{% block shell_styles %}
  .example-head{margin-bottom:22px}.example-head p:first-child{color:var(--anokii-shell-muted);font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.example-head h1{font-family:var(--anokii-shell-display-font,inherit);font-size:34px;line-height:1.1;margin:4px 0 8px}
  .example-drafts{list-style:none;max-width:760px;border:1px solid var(--anokii-shell-line);border-radius:14px;background:var(--anokii-shell-card)}
  .example-drafts li{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 18px;border-bottom:1px solid var(--anokii-shell-line)}.example-drafts li:last-child{border-bottom:0}
  .example-drafts small{display:block;color:var(--anokii-shell-muted)}
  .example-drafts button{min-height:40px;padding:8px 14px;border:1px solid var(--anokii-shell-accent);border-radius:9px;background:transparent;color:inherit;font:inherit;font-weight:650;cursor:pointer}
  .example-drafts button[aria-pressed="true"]{background:var(--anokii-shell-accent);color:var(--anokii-shell-accent-ink)}
  .example-drafts button:focus-visible{outline:3px solid var(--anokii-shell-accent);outline-offset:2px}
  .example-status{min-height:1.5em;margin-top:14px;color:var(--anokii-shell-muted)}
{% endblock %}

{% block content %}
<header class="example-head">
  <p>{{ page_eyebrow }}</p>
  <h1>{{ page_title }}</h1>
  <p>{{ page_intro }}</p>
</header>
<ul class="example-drafts" aria-label="Sample drafts">
  {% for draft in drafts %}
  <li>
    <div><b>{{ draft.title }}</b><small>{{ draft.audience }} · sample draft</small></div>
    <button type="button" aria-pressed="false" data-example-review>Reviewed</button>
  </li>
  {% endfor %}
</ul>
<p class="example-status" role="status" data-example-status></p>
{% endblock %}

{% block page_scripts %}
<script>
  (() => {
    const status = document.querySelector('[data-example-status]');
    document.querySelectorAll('[data-example-review]').forEach(button => {
      button.addEventListener('click', () => {
        const reviewed = button.getAttribute('aria-pressed') !== 'true';
        button.setAttribute('aria-pressed', String(reviewed));
        if (status) {
          status.textContent = reviewed ? 'Marked reviewed. Simulated: nothing is saved or sent.' : 'Review mark cleared.';
        }
      });
    });
  })();
</script>
{% endblock %}
