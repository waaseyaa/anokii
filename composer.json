{
    "name": "waaseyaa/anokii",
    "description": "Anokii, the first opinionated distribution built on Waaseyaa. Sovereign workspace for First Nations. OCAP-by-architecture. Working name pending language-keeper verification.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Russell Jones",
            "email": "jonesrussell42@gmail.com"
        },
        {
            "name": "Anokii Project Contributors"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "waaseyaa/anokii-core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/identity",
            "options": {
                "symlink": true,
                "versions": {
                    "waaseyaa/anokii-identity": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "packages/operator",
            "options": {
                "symlink": true,
                "versions": {
                    "waaseyaa/anokii-operator": "dev-main"
                }
            }
        }
    ],
    "require": {
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "php": "^8.5",
        "symfony/dotenv": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "twig/twig": "^3.0",
        "waaseyaa/ai-agent": "^0.1.0-alpha.305",
        "waaseyaa/anokii-core": "dev-main",
        "waaseyaa/anokii-identity": "dev-main",
        "waaseyaa/anokii-operator": "dev-main",
        "waaseyaa/deployer": "^0.1.0-alpha.305",
        "waaseyaa/full": "^0.1.0-alpha.305"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Anokii\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anokii\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "acceptance:frankenphp": "bash scripts/acceptance-frankenphp-http.sh",
        "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=1G",
        "check": [
            "@validate-project",
            "@test",
            "@analyse",
            "@style"
        ],
        "readiness:field-access": "php vendor/bin/waaseyaa field-access:preflight --format=json --write-artifact",
        "style": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "test": "phpunit",
        "validate-project": "composer validate --strict"
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "edit documents": {"title": "Edit documents", "description": "Create and update workspace documents."},
                "administer documents": {"title": "Administer documents", "description": "Administer workspace documents."},
                "edit drive": {"title": "Edit drive", "description": "Create and update workspace drive files."},
                "administer drive": {"title": "Administer drive", "description": "Administer workspace drive files."},
                "edit pages": {"title": "Edit pages", "description": "Create and update workspace pages."},
                "publish pages": {"title": "Publish pages", "description": "Publish reviewed workspace pages."},
                "administer pages": {"title": "Administer pages", "description": "Administer workspace pages."},
                "manage inbox": {"title": "Manage inbox", "description": "Read and manage workspace contact submissions."},
                "tool.entity.read": {"title": "Use entity read tools", "description": "Invoke workspace entity reads, subject to entity access policy."},
                "tool.entity.list": {"title": "Use entity list tools", "description": "Invoke workspace entity listings, subject to entity access policy."},
                "tool.entity.search": {"title": "Use entity search tools", "description": "Invoke workspace entity searches, subject to entity access policy."},
                "tool.entity.create": {"title": "Use entity create tools", "description": "Invoke workspace entity creation, subject to entity access policy."},
                "tool.entity.update": {"title": "Use entity update tools", "description": "Invoke workspace entity updates, subject to entity access policy."},
                "tool.entity.delete": {"title": "Use entity delete tools", "description": "Invoke workspace entity deletion, subject to entity access policy."}
            },
            "policies": [
                "Anokii\\Access\\ContactSubmissionAccessPolicy",
                "Anokii\\Access\\DocumentAccessPolicy",
                "Anokii\\Access\\DocumentNoteAccessPolicy",
                "Anokii\\Access\\DriveFileAccessPolicy",
                "Anokii\\Access\\PageAccessPolicy"
            ],
            "providers": [
                "Anokii\\Provider\\CoIntelligenceServiceProvider",
                "Anokii\\Provider\\WorkspaceServiceProvider"
            ]
        }
    }
}
