parameters:
    bootstrapFiles:
        - vendor/deployer/deployer/src/functions.php
    scanDirectories:
        - vendor/deployer/deployer/src
    scanFiles:
        - scripts/lib/FrameworkCohort.php
        - tools/lib/DevRuntimeConsumer.php
    level: max
    paths:
        - src
        - tests
        - packages/operator/src
        - packages/operator/tests
        - packages/operator/examples
        - packages/operator/demo
        - public
        - config/waaseyaa.php
        - deploy.php
    tmpDir: .phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true
