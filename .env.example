# Copy to .env locally and replace every placeholder. Never commit real values.
WAASEYAA_DB=storage/waaseyaa.sqlite
WAASEYAA_FILES_DIR=storage/files
ANOKII_COMMUNITY_ID=replace-with-the-instance-community-slug
WAASEYAA_APP_SECRET=base64:replace-with-canonical-base64-of-32-random-bytes
WAASEYAA_JWT_SECRET=replace-with-at-least-32-random-bytes
ANOKII_PRIVACY_SECRET=replace-with-a-separate-32-byte-random-secret

# Required behind a reverse proxy or Cloudflare Tunnel so Symfony resolves the
# real client address safely. Use only proxy IPs/CIDRs you operate; the Waaseyaa
# kernel also accepts REMOTE_ADDR for a directly connected trusted sidecar.
TRUSTED_PROXIES=

# Optional integrations.
ANTHROPIC_API_KEY=
ANOKII_WEB_RESEARCH=0
GOTENBERG_URL=
